COMPOSE_PROFILES=postgresql
POSTGRES_DB=gestaodeacao
POSTGRES_USER=gestao
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=5432

APP_PORT=8080
FRONTEND_PORT=4200

# Substitua os exemplos antes de iniciar; nunca versione o .env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters-before-use
JWT_EXPIRATION=60m
JWT_ISSUER=gestaodeacao
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-your-admin-password

# Configure para consultar os provedores; valores fictícios não fazem consultas reais.
TWELVE_DATA_API_KEY=test-key
BRAPI_TOKEN=

# Para usar PostgreSQL já instalado no host, remova COMPOSE_PROFILES=postgresql
# e configure DB_URL, DB_USERNAME e DB_PASSWORD somente no .env local.
# Exemplo de URL: jdbc:postgresql://host.docker.internal:5432/gestaodeacao
